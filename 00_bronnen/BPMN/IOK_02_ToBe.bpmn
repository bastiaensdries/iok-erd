        <bpmn:incoming>TOBE_D3_F18</bpmn:incoming>
        <bpmn:incoming>TOBE_D3_F21</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F19</bpmn:outgoing>
      </bpmn:serviceTask>
