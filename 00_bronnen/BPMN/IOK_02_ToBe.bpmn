      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="TOBE_D3_sync" name="Data en foto’s synchroniseren; metadata en koppelingen bijwerken">
        <bpmn:documentation>S01 p.9; S11 00:54-00:55; S02 p.3; S12 00:26-00:28, 00:36-00:42. O2: synctechniek en foto-upload naar SharePoint met metadata en verwijzing in Dataverse zijn nog te realiseren en te testen.</bpmn:documentation>
        <bpmn:incoming>TOBE_D3_F5</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="TOBE_D3_synced" name="Data en foto’s volledig en conflictvrij?" gatewayDirection="Diverging">
        <bpmn:documentation>S01 p.9; S11 00:07-00:08, 00:12-00:13. To-Be-uitwerking O2/O3/O4; technische fouten zijn expliciete herstelpaden.</bpmn:documentation>
        <bpmn:incoming>TOBE_D3_F6</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F7</bpmn:outgoing>
        <bpmn:outgoing>TOBE_D3_F9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="TOBE_D3_fixsync" name="Syncfout of conflict oplossen; lokale data behouden">
        <bpmn:documentation>O2: herstelpad bij mislukte upload, synchronisatie of conflict. Geen stilzwijgende overschrijving en geen verwijdering van nog niet veilig opgeslagen lokale foto’s.</bpmn:documentation>
        <bpmn:incoming>TOBE_D3_F7</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="TOBE_D3_review" name="Verslag op laptop nakijken, afwerken en indienen">
        <bpmn:documentation>S01 p.9; S11 00:07-00:08 en 00:52-00:53. O3: één inhoudelijk controlemoment door de eigen inspecteur; geen verplichte beheerdergoedkeuring.</bpmn:documentation>
        <bpmn:incoming>TOBE_D3_F9</bpmn:incoming>
        <bpmn:incoming>TOBE_D3_F13</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F10</bpmn:outgoing>
      </bpmn:userTask>
