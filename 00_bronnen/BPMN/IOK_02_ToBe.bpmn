        <bpmn:outgoing>TOBE_D3_F13</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="TOBE_D3_ra" name="Nieuwe uitgebreide risicoanalyse?" gatewayDirection="Diverging">
        <bpmn:documentation>S01 p.7-8: een extra preventiemaatregelen-document bij nieuwe uitgebreide risicoanalyse. Jaarlijkse gebreken worden wel in het verslag opgenomen, maar activeren niet automatisch een extra document.</bpmn:documentation>
        <bpmn:incoming>TOBE_D3_F14</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F15</bpmn:outgoing>
        <bpmn:outgoing>TOBE_D3_F16</bpmn:outgoing>
      </bpmn:exclusiveGateway>
