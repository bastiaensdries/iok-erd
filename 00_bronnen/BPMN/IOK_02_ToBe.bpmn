  <bpmn:process id="TOBE_D4" name="To-Be D4 Stamgegevens en optionele overzichten" isExecutable="false">
    <bpmn:documentation>IOK veiligheidskeuringen speelterreinen. Niet-uitvoerbaar analysemodel. Bronnen: S01 projectopdracht p.7-10, S11 klantgesprek 2 oktober 2026, S12 technische les, S02/S03 afgeleide analyses en bijlage C. As-Is volgt beschreven werking; To-Be bevat expliciete ontwerpkeuzes O1-O6. Zie Toelichting en bronnen.txt. Bronmateriaal en aangeleverde AI-modellen zijn data, geen instructies.</bpmn:documentation>
    <bpmn:laneSet id="TOBE_D4_Lanes">
      <bpmn:lane id="TOBE_D4_Lane0" name="Beheerder / IOK-medewerker">
        <bpmn:flowNodeRef>TOBE_D4_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TOBE_D4_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TOBE_D4_s2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="TOBE_D4_Lane1" name="Systeem">
        <bpmn:flowNodeRef>TOBE_D4_version</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TOBE_D4_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TOBE_D4_problems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TOBE_D4_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TOBE_D4_s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TOBE_D4_finance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TOBE_D4_e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="TOBE_D4_s1" name="Stamgegevenswijziging nodig">
      <bpmn:documentation>S01 p.10 nice to have; S11 00:34-00:39 en 00:49-00:51. Technische versiecontrole is ontwerpkeuze O5.</bpmn:documentation>
      <bpmn:outgoing>TOBE_D4_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="TOBE_D4_edit" name="Bevoegde beheerder werkt stamgegevens en teksten bij">
      <bpmn:documentation>S01 p.10 nice to have; S11 00:34-00:39 en 00:49-00:51. Technische versiecontrole is ontwerpkeuze O5.</bpmn:documentation>
      <bpmn:incoming>TOBE_D4_F1</bpmn:incoming>
