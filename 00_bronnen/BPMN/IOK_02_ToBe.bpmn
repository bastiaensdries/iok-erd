      <bpmn:incoming>TOBE_D4_F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="TOBE_D4_s3" name="Financieringsoverzicht gevraagd">
      <bpmn:documentation>S01 p.10; S11 00:15-00:16 en 00:56-00:58. Geen vaste maand- of jaartrigger opgelegd.</bpmn:documentation>
      <bpmn:outgoing>TOBE_D4_F6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="TOBE_D4_finance" name="Uitgevoerde controles en wegingsnummers naar Excel exporteren">
      <bpmn:documentation>S01 p.10. Alleen uitgevoerde controles tellen; geen tariefformule verzinnen en geen factuur genereren.</bpmn:documentation>
