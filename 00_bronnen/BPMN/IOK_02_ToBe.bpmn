        <bpmn:incoming>TOBE_D3_F16</bpmn:incoming>
        <bpmn:incoming>TOBE_D3_F17</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F18</bpmn:outgoing>
      </bpmn:exclusiveGateway>
