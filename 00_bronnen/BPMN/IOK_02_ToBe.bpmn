        <bpmn:incoming>TOBE_D3_F1</bpmn:incoming>
        <bpmn:incoming>TOBE_D3_F8</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F2</bpmn:outgoing>
        <bpmn:outgoing>TOBE_D3_F3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="TOBE_D3_wait" name="Wachten op verbinding">
        <bpmn:documentation>O2: wachten op beschikbare verbinding. Dit blokkeert het afronden van de rapportage, niet het offline veldwerk. Geen timer of permanente online-eis.</bpmn:documentation>
        <bpmn:incoming>TOBE_D3_F3</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F4</bpmn:outgoing>
