        <bpmn:incoming>TOBE_D3_F10</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="TOBE_D3_complete" name="Dossier volledig?" gatewayDirection="Diverging">
