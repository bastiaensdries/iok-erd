      <bpmn:documentation>Ontwerpkeuze O4: verzendfout mag niet als verzonden worden afgesloten.</bpmn:documentation>
      <bpmn:outgoing>TOBE_00_F8</bpmn:outgoing>
      <bpmn:errorEventDefinition id="TOBE_00_sendError_Error"/>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="TOBE_00_retry" name="Verzendfout oplossen en status controleren">
      <bpmn:documentation>Ontwerpkeuze O4: controleer of een verzendpoging al is uitgevoerd; voorkom onbedoeld dubbel verzenden.</bpmn:documentation>
      <bpmn:incoming>TOBE_00_F8</bpmn:incoming>
      <bpmn:outgoing>TOBE_00_F9</bpmn:outgoing>
    </bpmn:userTask>
