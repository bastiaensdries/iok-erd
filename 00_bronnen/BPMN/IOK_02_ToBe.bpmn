        <bpmn:incoming>TOBE_D3_F19</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F20</bpmn:outgoing>
        <bpmn:outgoing>TOBE_D3_F22</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="TOBE_D3_fixpdf" name="Generatiefout of opmaakprobleem oplossen">
        <bpmn:documentation>S01 p.9; S11 00:07-00:08, 00:12-00:13. To-Be-uitwerking O2/O3/O4; technische fouten zijn expliciete herstelpaden.</bpmn:documentation>
        <bpmn:incoming>TOBE_D3_F20</bpmn:incoming>
        <bpmn:outgoing>TOBE_D3_F21</bpmn:outgoing>
      </bpmn:userTask>
