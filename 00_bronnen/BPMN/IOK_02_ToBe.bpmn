          <bpmn:condition xsi:type="bpmn:tFormalExpression">Netwerkverbinding beschikbaar</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="TOBE_D3_joinnet" name="" gatewayDirection="Converging">
