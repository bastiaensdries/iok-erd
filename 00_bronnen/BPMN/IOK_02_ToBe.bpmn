        <bpmn:outgoing>TOBE_D3_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="TOBE_D3_online" name="Netwerk beschikbaar?" gatewayDirection="Diverging">
