    <bpmn:sendTask id="ASIS_00_send" name="Definitieve PDF(s) bezorgen aan bestuur">
      <bpmn:documentation>S01 p.7 en p.9; S11 00:12:47-00:13:15 en 01:07-01:09. PDF per terrein met zo nodig bijlage preventiemaatregelen. Geen verplichte portaaltoegang of Power BI-licentie voor ontvanger. To-Be: verzending na succesvolle archivering; kanaal en foutbeleid met klant bevestigen.</bpmn:documentation>
      <bpmn:incoming>ASIS_00_F5</bpmn:incoming>
      <bpmn:outgoing>ASIS_00_F6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="ASIS_00_archive" name="Verzonden versie in backoffice bewaren">
      <bpmn:documentation>S11 00:12:47-00:13:15 en 00:41. As-Is bewaart rapport in eigen backoffice; To-Be bewaart versie al in D3 en logt nu de bevestigde verzendopdracht (ontwerpkeuze O4). Verzendstatus is geen bewijs dat de ontvanger het bericht heeft gelezen.</bpmn:documentation>
      <bpmn:incoming>ASIS_00_F6</bpmn:incoming>
      <bpmn:outgoing>ASIS_00_F7</bpmn:outgoing>
    </bpmn:task>
