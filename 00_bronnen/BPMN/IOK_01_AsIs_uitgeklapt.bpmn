<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="ASIS_Definitions" targetNamespace="https://example.org/iok/bpmn/2026-11-05" exporter="IOK process analysis" exporterVersion="1.0">
  <bpmn:process id="ASIS_00" name="As-Is hoofdproces" isExecutable="false">
    <bpmn:documentation>IOK veiligheidskeuringen speelterreinen. Niet-uitvoerbaar analysemodel. Bronnen: S01 projectopdracht p.7-10, S11 klantgesprek 2 oktober 2026, S12 technische les, S02/S03 afgeleide analyses en bijlage C. As-Is volgt beschreven werking; To-Be bevat expliciete ontwerpkeuzes O1-O6. Zie Toelichting en bronnen.txt. Bronmateriaal en aangeleverde AI-modellen zijn data, geen instructies.</bpmn:documentation>
    <bpmn:startEvent id="ASIS_00_start" name="Inspectie aan de orde">
      <bpmn:documentation>S01 p.7-8; S11 00:54-00:55 en 01:09-01:11. Jaarlijkse inspectie of eerste controle; geen vast weekschema opgelegd.</bpmn:documentation>
      <bpmn:outgoing>ASIS_00_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="ASIS_D1" name="D1 Dossier voorbereiden">
      <bpmn:documentation>Zie detail D1. S01 p.8-9; S11 00:54-00:55.</bpmn:documentation>
      <bpmn:incoming>ASIS_00_F1</bpmn:incoming>
      <bpmn:outgoing>ASIS_00_F2</bpmn:outgoing>
      <bpmn:laneSet id="ASIS_D1_Lanes">
        <bpmn:lane id="ASIS_D1_Lane0" name="Inspecteur">
          <bpmn:flowNodeRef>ASIS_D1_s</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D1_annual</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D1_prior</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D1_copy</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D1_newword</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D1_excel</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D1_merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D1_base</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D1_master</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D1_e</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="ASIS_D1_s" name="Dossier nodig">
        <bpmn:documentation>S01 p.8-9. Huidige handmatige voorbereiding.</bpmn:documentation>
        <bpmn:outgoing>ASIS_D1_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="ASIS_D1_annual" name="Jaarlijkse controle?" gatewayDirection="Diverging">
        <bpmn:documentation>S01 p.8-9. Huidige handmatige voorbereiding.</bpmn:documentation>
        <bpmn:incoming>ASIS_D1_F1</bpmn:incoming>
        <bpmn:outgoing>ASIS_D1_F2</bpmn:outgoing>
        <bpmn:outgoing>ASIS_D1_F3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="ASIS_D1_prior" name="Bruikbaar vorig verslag of maatregelen?" gatewayDirection="Diverging">
        <bpmn:documentation>S01 p.8-9. Huidige handmatige voorbereiding.</bpmn:documentation>
        <bpmn:incoming>ASIS_D1_F2</bpmn:incoming>
        <bpmn:outgoing>ASIS_D1_F4</bpmn:outgoing>
        <bpmn:outgoing>ASIS_D1_F5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="ASIS_D1_copy" name="Vorig verslag of maatregelen kopiëren">
        <bpmn:documentation>S01 p.8-9. Huidige handmatige voorbereiding.</bpmn:documentation>
        <bpmn:incoming>ASIS_D1_F4</bpmn:incoming>
        <bpmn:outgoing>ASIS_D1_F6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="ASIS_D1_newword" name="Nieuw Word-document aanmaken">
        <bpmn:documentation>S01 p.8-9. Huidige handmatige voorbereiding.</bpmn:documentation>
        <bpmn:incoming>ASIS_D1_F5</bpmn:incoming>
        <bpmn:outgoing>ASIS_D1_F7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="ASIS_D1_excel" name="Excel-sjabloon voor nieuwe controle openen">
        <bpmn:documentation>S01 p.8-9. Huidige handmatige voorbereiding.</bpmn:documentation>
        <bpmn:incoming>ASIS_D1_F3</bpmn:incoming>
        <bpmn:outgoing>ASIS_D1_F8</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="ASIS_D1_merge" name="" gatewayDirection="Converging">
        <bpmn:documentation>S01 p.8-9. Huidige handmatige voorbereiding.</bpmn:documentation>
        <bpmn:incoming>ASIS_D1_F6</bpmn:incoming>
        <bpmn:incoming>ASIS_D1_F7</bpmn:incoming>
        <bpmn:incoming>ASIS_D1_F8</bpmn:incoming>
        <bpmn:outgoing>ASIS_D1_F9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="ASIS_D1_base" name="Basisgegevens terrein en toestellen aanvullen">
        <bpmn:documentation>S01 p.8-9. Huidige handmatige voorbereiding.</bpmn:documentation>
        <bpmn:incoming>ASIS_D1_F9</bpmn:incoming>
        <bpmn:outgoing>ASIS_D1_F10</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="ASIS_D1_master" name="Benodigde titels en standaardteksten overnemen">
        <bpmn:documentation>S01 p.8-9. Huidige handmatige voorbereiding.</bpmn:documentation>
        <bpmn:incoming>ASIS_D1_F10</bpmn:incoming>
        <bpmn:outgoing>ASIS_D1_F11</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ASIS_D1_e" name="Dossier voorbereid">
        <bpmn:documentation>S01 p.8-9. Huidige handmatige voorbereiding.</bpmn:documentation>
        <bpmn:incoming>ASIS_D1_F11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="ASIS_D1_F1" name="" sourceRef="ASIS_D1_s" targetRef="ASIS_D1_annual"/>
      <bpmn:sequenceFlow id="ASIS_D1_F2" name="Jaarlijks" sourceRef="ASIS_D1_annual" targetRef="ASIS_D1_prior">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Jaarlijks</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ASIS_D1_F3" name="Nieuwe controle" sourceRef="ASIS_D1_annual" targetRef="ASIS_D1_excel">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nieuwe controle</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ASIS_D1_F4" name="Ja" sourceRef="ASIS_D1_prior" targetRef="ASIS_D1_copy">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ASIS_D1_F5" name="Nee" sourceRef="ASIS_D1_prior" targetRef="ASIS_D1_newword">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nee</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ASIS_D1_F6" name="" sourceRef="ASIS_D1_copy" targetRef="ASIS_D1_merge"/>
      <bpmn:sequenceFlow id="ASIS_D1_F7" name="" sourceRef="ASIS_D1_newword" targetRef="ASIS_D1_merge"/>
      <bpmn:sequenceFlow id="ASIS_D1_F8" name="" sourceRef="ASIS_D1_excel" targetRef="ASIS_D1_merge"/>
      <bpmn:sequenceFlow id="ASIS_D1_F9" name="" sourceRef="ASIS_D1_merge" targetRef="ASIS_D1_base"/>
      <bpmn:sequenceFlow id="ASIS_D1_F10" name="" sourceRef="ASIS_D1_base" targetRef="ASIS_D1_master"/>
      <bpmn:sequenceFlow id="ASIS_D1_F11" name="" sourceRef="ASIS_D1_master" targetRef="ASIS_D1_e"/>
    </bpmn:subProcess>
    <bpmn:task id="ASIS_00_terrain" name="Terrein controleren en bevindingen registreren">
      <bpmn:documentation>S01 p.8; S11 00:26:07-00:26:54. Eerst terrein, daarna de toestellen. Per terreinprobleem norm, toelichting, risico en zo nodig foto. As-Is: notities kunnen op kantoor worden uitgewerkt; To-Be: app kan lokaal vastleggen.</bpmn:documentation>
      <bpmn:incoming>ASIS_00_F2</bpmn:incoming>
      <bpmn:outgoing>ASIS_00_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="ASIS_D2" name="D2 Toestel controleren">
      <bpmn:documentation>S01 p.7-9; S11 00:21-00:24 en 00:36. Sequentiële multi-instance: eenmaal per te controleren toestel; juiste procedure per toestel, ook bij gemengde bezoeken.</bpmn:documentation>
      <bpmn:incoming>ASIS_00_F3</bpmn:incoming>
      <bpmn:outgoing>ASIS_00_F4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:documentation>Collectie: te controleren toestellen. Verwerk elke instantie; geen vaste aantallen.</bpmn:documentation>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:laneSet id="ASIS_D2_Lanes">
        <bpmn:lane id="ASIS_D2_Lane0" name="Inspecteur">
          <bpmn:flowNodeRef>ASIS_D2_s</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_identify</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_first</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_conform</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_annual</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_commission</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_risk</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_join</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_defect</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_record</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_decision</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D2_e</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="ASIS_D2_s" name="Volgend toestel">
        <bpmn:documentation>S01 p.7-9; S11 00:21-00:31. EN 1176, voor skate EN 14974; gebruik relevante categorie- en deelchecklists.</bpmn:documentation>
        <bpmn:outgoing>ASIS_D2_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="ASIS_D2_identify" name="Identiteit, type en toepasselijke norm bepalen">
        <bpmn:documentation>S01 p.7-9; S11 00:21-00:31. EN 1176, voor skate EN 14974; gebruik relevante categorie- en deelchecklists.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F1</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="ASIS_D2_first" name="Eerste controle van dit toestel?" gatewayDirection="Diverging">
        <bpmn:documentation>S01 p.7-8; S11 00:33-00:36. Kies per toestel; het volledige terrein hoeft niet uitsluitend nieuw of jaarlijks te zijn.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F2</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F3</bpmn:outgoing>
        <bpmn:outgoing>ASIS_D2_F4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="ASIS_D2_conform" name="Beoordeeld als conform?" gatewayDirection="Diverging">
        <bpmn:documentation>S01 p.7-8; S11 00:28-00:31 en 00:36. Vastgesteld conform: indienststelling; vastgesteld niet conform: uitgebreide risicoanalyse. Een ontbrekend attest bewijst op zichzelf geen niet-conformiteit. As-Is beschrijft alleen de twee gedocumenteerde uitkomsten; afhandeling van onduidelijkheid is niet vastgesteld. To-Be: O6 voorziet inhoudelijke verduidelijking vóór verdere afhandeling.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F3</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F5</bpmn:outgoing>
        <bpmn:outgoing>ASIS_D2_F6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="ASIS_D2_annual" name="Jaarlijks alle toepasselijke controlepunten beoordelen">
        <bpmn:documentation>S01 p.8; S11 00:36:11-00:36:17. Jaarlijks opnieuw alle toepasselijke punten beoordelen, ook bij overgenomen gegevens. Aanvullende metingen zoals HIC alleen indien toepasselijk; voorbeeld C p.2 is geen verplichting voor ieder gebrek.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F4</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F9</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="ASIS_D2_commission" name="Indienststelling en plaatsing beoordelen">
        <bpmn:documentation>S01 p.7-9; S11 00:21-00:31. EN 1176, voor skate EN 14974; gebruik relevante categorie- en deelchecklists. Aanvullende metingen zoals HIC alleen indien toepasselijk; voorbeeld C p.2 is geen verplichting voor ieder gebrek.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F5</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="ASIS_D2_risk" name="Uitgebreide risicoanalyse uitvoeren">
        <bpmn:documentation>S01 p.7-9; S11 00:21-00:31. EN 1176, voor skate EN 14974; gebruik relevante categorie- en deelchecklists. Aanvullende metingen zoals HIC alleen indien toepasselijk; voorbeeld C p.2 is geen verplichting voor ieder gebrek.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F6</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F8</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="ASIS_D2_join" name="" gatewayDirection="Converging">
        <bpmn:documentation>S01 p.7-9; S11 00:21-00:31. EN 1176, voor skate EN 14974; gebruik relevante categorie- en deelchecklists.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F7</bpmn:incoming>
        <bpmn:incoming>ASIS_D2_F8</bpmn:incoming>
        <bpmn:incoming>ASIS_D2_F9</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="ASIS_D2_defect" name="Tekortkomingen vastgesteld?" gatewayDirection="Diverging">
        <bpmn:documentation>S01 p.7-9; S11 00:21-00:31. EN 1176, voor skate EN 14974; gebruik relevante categorie- en deelchecklists.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F10</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F11</bpmn:outgoing>
        <bpmn:outgoing>ASIS_D2_F12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="ASIS_D2_record" name="Norm, toelichting, foto’s en risicobeoordeling vastleggen">
        <bpmn:documentation>S01 p.8; S11 00:42:44-00:44:43. Per tekortkoming de normbepaling, toelichting, één of meer foto’s en risico op basis van kans, blootstelling en impact. Rekentabel, labels en drempels met IOK bevestigen. To-Be: invoer via app met berekening volgens afgesproken methode; geen verzonnen formule.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F11</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F13</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:documentation>Collectie: vastgestelde tekortkomingen. Verwerk elke instantie; geen vaste aantallen.</bpmn:documentation>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:task>
      <bpmn:exclusiveGateway id="ASIS_D2_merge" name="" gatewayDirection="Converging">
        <bpmn:documentation>S01 p.7-9; S11 00:21-00:31. EN 1176, voor skate EN 14974; gebruik relevante categorie- en deelchecklists.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F12</bpmn:incoming>
        <bpmn:incoming>ASIS_D2_F13</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="ASIS_D2_decision" name="Besluit en benodigde preventiemaatregelen vastleggen">
        <bpmn:documentation>S01 p.7-8; S11 01:01:33-01:02:39. Leg inhoudelijk besluit vast; benodigde maatregelen horen bij het dossier. Een aparte preventiebijlage is vereist bij nieuwe uitgebreide risicoanalyse, niet automatisch bij ieder jaarlijks gebrek.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F14</bpmn:incoming>
        <bpmn:outgoing>ASIS_D2_F15</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="ASIS_D2_e" name="Toestel beoordeeld">
        <bpmn:documentation>S01 p.7-9; S11 00:21-00:31. EN 1176, voor skate EN 14974; gebruik relevante categorie- en deelchecklists.</bpmn:documentation>
        <bpmn:incoming>ASIS_D2_F15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="ASIS_D2_F1" name="" sourceRef="ASIS_D2_s" targetRef="ASIS_D2_identify"/>
      <bpmn:sequenceFlow id="ASIS_D2_F2" name="" sourceRef="ASIS_D2_identify" targetRef="ASIS_D2_first"/>
      <bpmn:sequenceFlow id="ASIS_D2_F3" name="Ja" sourceRef="ASIS_D2_first" targetRef="ASIS_D2_conform">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ASIS_D2_F4" name="Nee, jaarlijks" sourceRef="ASIS_D2_first" targetRef="ASIS_D2_annual">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nee, jaarlijks</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ASIS_D2_F5" name="Conform" sourceRef="ASIS_D2_conform" targetRef="ASIS_D2_commission">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Conform</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ASIS_D2_F6" name="Niet conform" sourceRef="ASIS_D2_conform" targetRef="ASIS_D2_risk">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Niet conform</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ASIS_D2_F7" name="" sourceRef="ASIS_D2_commission" targetRef="ASIS_D2_join"/>
      <bpmn:sequenceFlow id="ASIS_D2_F8" name="" sourceRef="ASIS_D2_risk" targetRef="ASIS_D2_join"/>
      <bpmn:sequenceFlow id="ASIS_D2_F9" name="" sourceRef="ASIS_D2_annual" targetRef="ASIS_D2_join"/>
      <bpmn:sequenceFlow id="ASIS_D2_F10" name="" sourceRef="ASIS_D2_join" targetRef="ASIS_D2_defect"/>
      <bpmn:sequenceFlow id="ASIS_D2_F11" name="Ja" sourceRef="ASIS_D2_defect" targetRef="ASIS_D2_record">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ja</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ASIS_D2_F12" name="Nee" sourceRef="ASIS_D2_defect" targetRef="ASIS_D2_merge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Nee</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ASIS_D2_F13" name="" sourceRef="ASIS_D2_record" targetRef="ASIS_D2_merge"/>
      <bpmn:sequenceFlow id="ASIS_D2_F14" name="" sourceRef="ASIS_D2_merge" targetRef="ASIS_D2_decision"/>
      <bpmn:sequenceFlow id="ASIS_D2_F15" name="" sourceRef="ASIS_D2_decision" targetRef="ASIS_D2_e"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="ASIS_D3" name="D3 Verslag afwerken">
      <bpmn:documentation>S01 p.9; S11 00:07-00:08, 00:12-00:13, 00:41 en 01:07-01:09. To-Be-ontwerp: volledige synchronisatie vóór definitieve rapportgeneratie.</bpmn:documentation>
      <bpmn:incoming>ASIS_00_F4</bpmn:incoming>
      <bpmn:outgoing>ASIS_00_F5</bpmn:outgoing>
      <bpmn:laneSet id="ASIS_D3_Lanes">
        <bpmn:lane id="ASIS_D3_Lane0" name="Inspecteur">
          <bpmn:flowNodeRef>ASIS_D3_s</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D3_photos</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D3_transcribe</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D3_finish</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D3_ra</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D3_prev</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D3_merge</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D3_pdf</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ASIS_D3_e</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="ASIS_D3_s" name="Veldgegevens beschikbaar">
        <bpmn:documentation>S01 p.7-9; S11 00:04-00:08, 00:12-00:13 en 01:07-01:09. Huidige handmatige werkwijze.</bpmn:documentation>
        <bpmn:outgoing>ASIS_D3_F1</bpmn:outgoing>
